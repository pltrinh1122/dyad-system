{
  "@context": [
    "https://schema.org",
    {
      "dyad": "urn:dyad:term:"
    }
  ],
  "@id": "urn:dyad:dmc:chronicle/collateral-why-tree",
  "@type": [
    "DefinedTermSet",
    "dyad:DecisionCriterion"
  ],
  "identifier": "collateral-why-tree",
  "name": "Why-tree",
  "description": "Whether a canvas set's single why-tree, its segments as tags on every node, is complete and current enough to screen new problems and to select a segment's root causes.",
  "dyad:decides": "Is this why-tree ready to select root causes from and to answer lookups?",
  "dyad:inputs": [
    "the why-tree file: its header's tree digest and per-tag digests, and every node with its tags and per-tag outcomes",
    "each node's collateral-problem-depth outcome per tag",
    "the sha256 of the node lines, whole and per tag, as committed",
    "evidence about a segment that arrived after the tree was judged"
  ],
  "hasDefinedTerm": [
    {
      "@type": "DefinedTerm",
      "termCode": "open-branch",
      "name": "open-branch",
      "dyad:when": "a leaf is neither a root cause, the anchor nor a join",
      "dyad:then": "ask why of it until the branch stops"
    },
    {
      "@type": "DefinedTerm",
      "termCode": "circular",
      "name": "circular",
      "dyad:when": "a root cause rewords an ancestor in its own branch",
      "dyad:then": "ask why of the ancestor again; the reworded node is superseded"
    },
    {
      "@type": "DefinedTerm",
      "termCode": "too-deep",
      "name": "too-deep",
      "dyad:when": "a branch passes five whys without stopping",
      "dyad:then": "the branch has left the segment: find where, and stop it there"
    },
    {
      "@type": "DefinedTerm",
      "termCode": "no-anchor-branch",
      "name": "no-anchor-branch",
      "dyad:when": "no branch reaches the root anchor",
      "dyad:then": "ask the reverse question of the symptom: why do I feel I must do this at all?"
    },
    {
      "@type": "DefinedTerm",
      "termCode": "untested",
      "name": "untested",
      "dyad:when": "a root cause has not passed the removal test",
      "dyad:then": "test it with collateral-problem-depth"
    },
    {
      "@type": "DefinedTerm",
      "termCode": "untagged",
      "name": "untagged",
      "dyad:when": "a node carries no segment tag",
      "dyad:then": "tag it with the segments it holds for, or supersede it"
    },
    {
      "@type": "DefinedTerm",
      "termCode": "untested-tag",
      "name": "untested-tag",
      "dyad:when": "a tag's outcome on a node is root-cause and that tag has no removal-test line of its own",
      "dyad:then": "write the tag's removal test, counting only that segment's symptoms"
    },
    {
      "@type": "DefinedTerm",
      "termCode": "stale",
      "name": "stale",
      "dyad:when": "the lines no longer match the digest a lookup depends on (the tree digest for screening, the tag's digest for a segment's selection), or evidence about a segment arrived after the tree was judged",
      "dyad:then": "place the new evidence, re-derive where it bears, and judge the tree again"
    },
    {
      "@type": "DefinedTerm",
      "termCode": "ready",
      "name": "ready",
      "dyad:when": "every test above holds",
      "dyad:then": "record the outcome, the tree digest and each tag's digest in the header; select a segment's root causes from the nodes tagged with it, ranked first by whether its anchor branch exits through them, then by how many of its branches join them; the tree screens new problems until it changes"
    }
  ],
  "dyad:precedence": "in the order listed; the first test that fails gives the outcome",
  "dyad:default": "when a test cannot be decided, the tree is not ready and the lookup returns no outcome",
  "dyad:judgedBy": {
    "dyad:kind": "inference",
    "dyad:implementation": null
  },
  "isPartOf": "urn:dyad:craft:chronicle",
  "dyad:home": "rules/collateral.md",
  "dyad:alsoIn": [
    "rules/chronicle.md"
  ],
  "dyad:owner": "chronicle:collateral"
}
