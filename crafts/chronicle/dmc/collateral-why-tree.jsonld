{
  "@context": [
    "https://schema.org",
    {
      "dyad": "urn:dyad:term:"
    }
  ],
  "@id": "urn:dyad:dmc:chronicle/collateral-why-tree",
  "@type": [
    "DefinedTermSet",
    "dyad:DecisionCriterion"
  ],
  "identifier": "collateral-why-tree",
  "name": "Why-tree",
  "description": "Whether a why-tree of a canvas set — a segment's source tree, or the projection rebuilt from every source tree with segments as tags — is complete and current enough to select a segment's root causes from, or to screen new problems against.",
  "dyad:decides": "Is this why-tree ready to select root causes from and to answer lookups?",
  "dyad:inputs": [
    "the why-tree file: a source tree's header digest and nodes, or the projection's header (its digest, each tag's and each source tree's) and every line with its tags, per-tag outcomes and sources",
    "each node's collateral-problem-depth outcome, per tag on the projection",
    "the sha256 of the lines after the header, whole and per tag, as committed",
    "each source tree's sha256, as committed, against the one the projection names",
    "evidence about a segment that arrived after the tree was judged"
  ],
  "hasDefinedTerm": [
    {
      "@type": "DefinedTerm",
      "termCode": "open-branch",
      "name": "open-branch",
      "dyad:when": "a leaf is neither a root cause, the anchor nor a join",
      "dyad:then": "ask why of it until the branch stops"
    },
    {
      "@type": "DefinedTerm",
      "termCode": "circular",
      "name": "circular",
      "dyad:when": "a root cause rewords an ancestor in its own branch",
      "dyad:then": "ask why of the ancestor again; the reworded node is superseded"
    },
    {
      "@type": "DefinedTerm",
      "termCode": "too-deep",
      "name": "too-deep",
      "dyad:when": "a branch passes five whys without stopping",
      "dyad:then": "the branch has left the segment: find where, and stop it there"
    },
    {
      "@type": "DefinedTerm",
      "termCode": "no-anchor-branch",
      "name": "no-anchor-branch",
      "dyad:when": "no branch reaches the root anchor",
      "dyad:then": "ask the reverse question of the symptom: why do I feel I must do this at all?"
    },
    {
      "@type": "DefinedTerm",
      "termCode": "untested",
      "name": "untested",
      "dyad:when": "a root cause has not passed the removal test",
      "dyad:then": "test it with collateral-problem-depth"
    },
    {
      "@type": "DefinedTerm",
      "termCode": "untagged",
      "name": "untagged",
      "dyad:when": "a projected node carries no segment tag (a projection test; a source tree skips it)",
      "dyad:then": "project it again from its sources, which give its tags"
    },
    {
      "@type": "DefinedTerm",
      "termCode": "untested-tag",
      "name": "untested-tag",
      "dyad:when": "on the projection, a tag's outcome on a node is root-cause and that tag has no removal-test line of its own",
      "dyad:then": "project the removal test from the segment's source tree, where it is written counting only that segment's symptoms"
    },
    {
      "@type": "DefinedTerm",
      "termCode": "unsourced",
      "name": "unsourced",
      "dyad:when": "a line of the projection names no source node, or names one that is not in that segment's source tree",
      "dyad:then": "the line was written by hand or its source was lost: rebuild the projection from the source trees"
    },
    {
      "@type": "DefinedTerm",
      "termCode": "unprojected",
      "name": "unprojected",
      "dyad:when": "a line of a source tree has no line of the projection naming it",
      "dyad:then": "project the source tree again: look the node up, map it as known or new"
    },
    {
      "@type": "DefinedTerm",
      "termCode": "stale",
      "name": "stale",
      "dyad:when": "the lines no longer match the digest the reader depends on (a source tree's own digest for a segment's selection; the projection's for screening), a source tree's digest differs from the one the projection names, or evidence about a segment arrived after the tree was judged",
      "dyad:then": "place the new evidence in the segment's source tree, re-derive where it bears, judge it again, and project again"
    },
    {
      "@type": "DefinedTerm",
      "termCode": "ready",
      "name": "ready",
      "dyad:when": "every test above holds",
      "dyad:then": "record the outcome and the digests in the header; from a source tree select the segment's root causes, ranked first by whether its anchor branch exits through them, then by how many of its branches join them; the projection screens new problems until a source changes"
    }
  ],
  "dyad:precedence": "in the order listed; the first test that fails gives the outcome; a source tree skips untagged, untested-tag, unsourced and unprojected",
  "dyad:default": "when a test cannot be decided, the tree is not ready and the lookup returns no outcome",
  "dyad:judgedBy": {
    "dyad:kind": "inference",
    "dyad:implementation": null
  },
  "isPartOf": "urn:dyad:craft:chronicle",
  "dyad:home": "rules/collateral.md",
  "dyad:alsoIn": [
    "rules/chronicle.md"
  ],
  "dyad:owner": "chronicle:collateral"
}
