{
  "@context": [
    "https://schema.org",
    {
      "dyad": "urn:dyad:term:"
    }
  ],
  "@id": "urn:dyad:dmc:chronicle/collateral-problem-depth",
  "@type": [
    "DefinedTermSet",
    "dyad:DecisionCriterion"
  ],
  "identifier": "collateral-problem-depth",
  "name": "Problem depth",
  "description": "Whether a node of a segment's why-tree is a symptom, a cause, a root cause or the anchor, the per-node test of problem discovery.",
  "dyad:decides": "Is this node of the why-tree a symptom, a cause, a root cause or the anchor?",
  "dyad:inputs": [
    "the segment's why-tree, read first: a claim matching a node takes that node's outcome and label, as recorded",
    "the node's statement",
    "its children and joins",
    "its ancestors in its branch",
    "the root anchor written for the segment"
  ],
  "hasDefinedTerm": [
    {
      "@type": "DefinedTerm",
      "termCode": "symptom",
      "name": "symptom",
      "dyad:when": "the statement names something the segment observes",
      "dyad:then": "keep it as a symptom, in the segment's words, and ask why it happens"
    },
    {
      "@type": "DefinedTerm",
      "termCode": "cause",
      "name": "cause",
      "dyad:when": "it explains symptoms, but a deeper why explains it",
      "dyad:then": "ask why again"
    },
    {
      "@type": "DefinedTerm",
      "termCode": "root-cause",
      "name": "root-cause",
      "dyad:when": "removing it removes most of the symptoms whose branches reach it, the next why reaches the root anchor, and it does not reword an ancestor in its own branch",
      "dyad:then": "a candidate problem entry, labelled hypothesis until a reader confirms it"
    },
    {
      "@type": "DefinedTerm",
      "termCode": "anchor",
      "name": "anchor",
      "dyad:when": "the answer is the root anchor itself",
      "dyad:then": "the branch stops; on the anchor branch it shows what the symptom protects"
    },
    {
      "@type": "DefinedTerm",
      "termCode": "solution-shaped",
      "name": "solution-shaped",
      "dyad:when": "it names a missing feature rather than something the segment suffers",
      "dyad:then": "restate it as what the segment suffers, then judge it again"
    }
  ],
  "dyad:precedence": "the first outcome whose condition holds; a statement that is both a symptom and solution-shaped is restated first",
  "dyad:default": "when the removal test cannot be decided, the node is held as a cause and put to the Operator; a claim matching no node is placed in the tree first",
  "dyad:judgedBy": {
    "dyad:kind": "inference",
    "dyad:implementation": null
  },
  "isPartOf": "urn:dyad:craft:chronicle",
  "dyad:home": "rules/collateral.md",
  "dyad:alsoIn": [
    "rules/chronicle.md"
  ],
  "dyad:owner": "chronicle:collateral"
}
