{
  "@context": [
    "https://schema.org",
    {
      "dyad": "urn:dyad:term:"
    }
  ],
  "@id": "urn:dyad:dmc:chronicle/collateral-problem-depth",
  "@type": [
    "DefinedTermSet",
    "dyad:DecisionCriterion"
  ],
  "identifier": "collateral-problem-depth",
  "name": "Problem depth",
  "description": "Whether a node of a segment's source why-tree is a symptom, a cause, a root cause or the anchor, the per-node test of problem discovery; and, when a new problem is screened, whether it is already known in the projection.",
  "dyad:decides": "Is this claim or node of the why-tree known, a symptom, a cause, a root cause or the anchor, for the segment asked about?",
  "dyad:inputs": [
    "when screening a new claim, the canvas set's projection, read first: a claim matching any projected node, whatever its tags, is known and takes that node's outcome for the claim's segment, with its label and its sources; never read while a segment's source tree is derived",
    "the node's statement",
    "its children and joins, in its source tree",
    "its ancestors in its branch, in its source tree",
    "the root anchor written for the segment",
    "the segment (tag) the claim is asked for"
  ],
  "hasDefinedTerm": [
    {
      "@type": "DefinedTerm",
      "termCode": "known",
      "name": "known",
      "dyad:when": "when screening, the claim matches by meaning a node already in the projection",
      "dyad:then": "take that node's outcome for the claim's segment, with its label, its path and its sources; a claim raised as a new problem is named a red herring; new information goes into the segment's source tree as a new symptom node joined to the known parent, and is projected; a segment the node is not tagged with makes it a tag candidate"
    },
    {
      "@type": "DefinedTerm",
      "termCode": "symptom",
      "name": "symptom",
      "dyad:when": "the statement names something the segment observes",
      "dyad:then": "keep it as a symptom, in the segment's words, and ask why it happens"
    },
    {
      "@type": "DefinedTerm",
      "termCode": "cause",
      "name": "cause",
      "dyad:when": "it explains symptoms, but a deeper why explains it",
      "dyad:then": "ask why again"
    },
    {
      "@type": "DefinedTerm",
      "termCode": "root-cause",
      "name": "root-cause",
      "dyad:when": "removing it removes most of the symptoms whose branches reach it, the next why reaches the root anchor, and it does not reword an ancestor in its own branch",
      "dyad:then": "a candidate problem entry, labelled hypothesis until a reader confirms it"
    },
    {
      "@type": "DefinedTerm",
      "termCode": "anchor",
      "name": "anchor",
      "dyad:when": "the answer is the root anchor itself",
      "dyad:then": "the branch stops; on the anchor branch it shows what the symptom protects"
    },
    {
      "@type": "DefinedTerm",
      "termCode": "solution-shaped",
      "name": "solution-shaped",
      "dyad:when": "it names a missing feature rather than something the segment suffers",
      "dyad:then": "restate it as what the segment suffers, then judge it again"
    }
  ],
  "dyad:precedence": "known first when screening, and never while a source tree is derived; then the first outcome whose condition holds, read for the claim's segment; a statement that is both a symptom and solution-shaped is restated first",
  "dyad:default": "when the removal test cannot be decided, the node is held as a cause and put to the Operator; a claim matching no projected node is placed in a source tree first and projected",
  "dyad:judgedBy": {
    "dyad:kind": "inference",
    "dyad:implementation": null
  },
  "isPartOf": "urn:dyad:craft:chronicle",
  "dyad:home": "rules/collateral.md",
  "dyad:alsoIn": [
    "rules/chronicle.md"
  ],
  "dyad:owner": "chronicle:collateral"
}
