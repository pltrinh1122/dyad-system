{
  "@context": [
    "https://schema.org",
    {
      "dyad": "urn:dyad:term:"
    }
  ],
  "@id": "urn:dyad:dmc:chronicle/collateral-lean-canvas-customer-segments",
  "@type": [
    "DefinedTermSet",
    "dyad:DecisionCriterion"
  ],
  "identifier": "collateral-lean-canvas-customer-segments",
  "name": "Lean canvas: customer segments",
  "description": "The customer segments section of a lean canvas: who has the problem, and who will try a solution first.",
  "dyad:decides": "What does the customer segments section of this lean canvas need?",
  "dyad:inputs": [
    "the customer segments section",
    "its early adopters"
  ],
  "hasDefinedTerm": [
    {
      "@type": "DefinedTerm",
      "termCode": "too-broad",
      "name": "too-broad",
      "dyad:when": "the segment is too broad to find one person in it",
      "dyad:then": "narrow it until one person in it can be found"
    },
    {
      "@type": "DefinedTerm",
      "termCode": "no-early-adopters",
      "name": "no-early-adopters",
      "dyad:when": "the early adopters, the members who feel the problem most and will try a solution first, are not named",
      "dyad:then": "name them"
    },
    {
      "@type": "DefinedTerm",
      "termCode": "ready",
      "name": "ready",
      "dyad:when": "every test above holds",
      "dyad:then": "the customer segments section is ready; the canvas's fit record is applied once every section is ready"
    }
  ],
  "dyad:precedence": "in the order listed, after the collateral gate passes; the first test that fails gives the outcome",
  "dyad:default": "when a test cannot be decided from the section and its sources, the section does not pass it: the agent asks the Operator",
  "dyad:judgedBy": {
    "dyad:kind": "inference",
    "dyad:implementation": null
  },
  "isPartOf": "urn:dyad:craft:chronicle",
  "dyad:home": "rules/collateral.md",
  "dyad:alsoIn": [
    "rules/chronicle.md"
  ],
  "dyad:owner": "chronicle:collateral"
}
