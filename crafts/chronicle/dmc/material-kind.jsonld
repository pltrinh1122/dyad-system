{
  "@context": [
    "https://schema.org",
    {
      "dyad": "urn:dyad:term:"
    }
  ],
  "@id": "urn:dyad:dmc:chronicle/material-kind",
  "@type": [
    "DefinedTermSet",
    "dyad:DecisionCriterion"
  ],
  "identifier": "material-kind",
  "name": "Episode material",
  "description": "Which kind of material a passage told in an episode draws on: the record layer's two, or the persona's fiction layer.",
  "dyad:decides": "What material does this event draw on?",
  "dyad:inputs": [
    "the event or passage",
    "its footnote citation",
    "its fiction marker and the episode's fiction header"
  ],
  "hasDefinedTerm": [
    {
      "@type": "DefinedTerm",
      "termCode": "record",
      "name": "record",
      "dyad:when": "what the system's repos hold, cited as path: or repo:",
      "dyad:then": "told, with a record citation"
    },
    {
      "@type": "DefinedTerm",
      "termCode": "context",
      "name": "Operator's context",
      "dyad:when": "the Operator's own words about the world outside the repo, cited as prov:",
      "dyad:then": "told, with a context citation"
    },
    {
      "@type": "DefinedTerm",
      "termCode": "fiction",
      "name": "fiction layer",
      "dyad:when": "the persona's character, inner life or daemons: private, not held by the record",
      "dyad:then": "told as fiction based on a real-life model, uncited, in a paragraph opening with the fiction marker under the episode's fiction header; a citation inside it, or a marker with no header, fails the guard"
    },
    {
      "@type": "DefinedTerm",
      "termCode": "gap",
      "name": "gap",
      "dyad:when": "the record layer's material, neither record nor the Operator's context holds it",
      "dyad:then": "reported as a gap, never filled; an uncited footnote fails the guard"
    }
  ],
  "dyad:judgedBy": {
    "dyad:kind": "mechanical",
    "dyad:implementation": "guards/episodes.py"
  },
  "isPartOf": "urn:dyad:craft:chronicle",
  "dyad:home": "rules/chronicle.md",
  "dyad:owner": "chronicle:chronicle"
}
