{
  "@context": [
    "https://schema.org",
    {
      "dyad": "urn:dyad:term:"
    }
  ],
  "@id": "urn:dyad:dmc:chronicle/collateral-lean-canvas-solution",
  "@type": [
    "DefinedTermSet",
    "dyad:DecisionCriterion"
  ],
  "identifier": "collateral-lean-canvas-solution",
  "name": "Lean canvas: solution",
  "description": "The solution section of a lean canvas: the smallest set of features that answers the top problems.",
  "dyad:decides": "What does the solution section of this lean canvas need?",
  "dyad:inputs": [
    "the solution section",
    "the problem section"
  ],
  "hasDefinedTerm": [
    {
      "@type": "DefinedTerm",
      "termCode": "untied",
      "name": "untied",
      "dyad:when": "a feature names no problem it answers",
      "dyad:then": "tie it to a listed problem or cut it"
    },
    {
      "@type": "DefinedTerm",
      "termCode": "not-minimal",
      "name": "not-minimal",
      "dyad:when": "more than one feature is listed for a top problem",
      "dyad:then": "keep the one that answers it"
    },
    {
      "@type": "DefinedTerm",
      "termCode": "ready",
      "name": "ready",
      "dyad:when": "every test above holds",
      "dyad:then": "the solution section is ready; the canvas's fit record is applied once every section is ready"
    }
  ],
  "dyad:precedence": "in the order listed, after the collateral gate passes; the first test that fails gives the outcome",
  "dyad:default": "when a test cannot be decided from the section and its sources, the section does not pass it: the agent asks the Operator",
  "dyad:judgedBy": {
    "dyad:kind": "inference",
    "dyad:implementation": null
  },
  "isPartOf": "urn:dyad:craft:chronicle",
  "dyad:home": "rules/collateral.md",
  "dyad:alsoIn": [
    "rules/chronicle.md"
  ],
  "dyad:owner": "chronicle:collateral"
}
