{
  "@context": [
    "https://schema.org",
    {
      "dyad": "urn:dyad:term:"
    }
  ],
  "@id": "urn:dyad:dmc:sysadmin/backup-exclude",
  "@type": [
    "DefinedTermSet",
    "dyad:DecisionCriterion"
  ],
  "identifier": "backup-exclude",
  "name": "Snapshot exclusion",
  "description": "Whether a path goes into a system snapshot or is excluded from it.",
  "dyad:decides": "Is this path excluded from the snapshot?",
  "dyad:inputs": [
    "the path",
    "whether it is temporary, a log, a cache, runtime, a lock, a virtual filesystem, a mounted drive, recovery or the snapshot store"
  ],
  "hasDefinedTerm": [
    {
      "@type": "DefinedTerm",
      "termCode": "exclude",
      "name": "exclude",
      "dyad:when": "temporary files, logs, caches, runtime and lock files, virtual filesystems, mounted drives, the recovery directory or the snapshots themselves",
      "dyad:then": "listed in the exclude array of the snapshot configuration"
    },
    {
      "@type": "DefinedTerm",
      "termCode": "include",
      "name": "include",
      "dyad:when": "any other path of the system",
      "dyad:then": "snapshotted"
    }
  ],
  "dyad:judgedBy": {
    "dyad:kind": "inference",
    "dyad:implementation": null
  },
  "isPartOf": "urn:dyad:craft:sysadmin",
  "dyad:home": "docs/backup-timeshift.md",
  "dyad:owner": "sysadmin:backup-timeshift"
}
