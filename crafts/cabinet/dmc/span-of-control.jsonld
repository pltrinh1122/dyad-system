{
  "@context": [
    "https://schema.org",
    {
      "dyad": "urn:dyad:term:"
    }
  ],
  "@id": "urn:dyad:dmc:cabinet/span-of-control",
  "@type": [
    "DefinedTermSet",
    "dyad:DecisionCriterion"
  ],
  "identifier": "span-of-control",
  "name": "Span of control",
  "description": "Whether the dyad units are within the span the operator can attend, and what a long board is instead.",
  "dyad:decides": "Is the operator's span within seven dyad units, and is a long board a span matter?",
  "dyad:inputs": [
    "the dyad units: the home and every unit paired-units names",
    "whether a unit is a dyad unit or a solo, a secretary or a desk",
    "the lines on the home's roll-up"
  ],
  "hasDefinedTerm": [
    {
      "@type": "DefinedTerm",
      "termCode": "within",
      "name": "at most seven dyad units",
      "dyad:when": "the home and the paired units number seven or fewer",
      "dyad:then": "nothing to do; pairing one more is the operator's act, weighed by the core's attendance criterion"
    },
    {
      "@type": "DefinedTerm",
      "termCode": "over",
      "name": "pairing past seven",
      "dyad:when": "a pairing would make more than seven dyad units, or has",
      "dyad:then": "the signal to unpair a unit, which becomes a solo routed through the home; proposed to the operator, never done by a unit; never a reason to retire, merge or split a solo"
    },
    {
      "@type": "DefinedTerm",
      "termCode": "solo",
      "name": "never counted",
      "dyad:when": "the unit is a solo: a secretary or a desk the operator has not paired",
      "dyad:then": "not counted against the span; how many run is bounded by the host's capacity and each charter's ceiling (unit-lifecycle)"
    },
    {
      "@type": "DefinedTerm",
      "termCode": "board",
      "name": "a channel matter",
      "dyad:when": "the home's roll-up runs past seven lines",
      "dyad:then": "fold quiet units' lines; attention-problem's channel outcome (the relay form, the line limit, batching, the inbox); never a span matter, never a reason to retire a unit"
    }
  ],
  "dyad:precedence": "Count dyad units only. A solo never enters the count. A long board is the channel's, never the span's.",
  "dyad:judgedBy": {
    "dyad:kind": "inference",
    "dyad:implementation": null
  },
  "isPartOf": "urn:dyad:craft:cabinet",
  "dyad:home": "rules/organization.md",
  "dyad:alsoIn": [
    "docs/operating-guide.md"
  ],
  "dyad:owner": "cabinet:organization"
}
