{
  "@context": [
    "https://schema.org",
    {
      "dyad": "urn:dyad:term:"
    }
  ],
  "@id": "urn:dyad:dmc:dyad-operator/trace-window",
  "@type": [
    "DefinedTermSet",
    "dyad:DecisionCriterion"
  ],
  "identifier": "trace-window",
  "name": "Trace window",
  "description": "Decides where a trace's window ends.",
  "dyad:decides": "Where does this trace's window end?",
  "dyad:inputs": [
    "whether --out is given",
    "whether --said-file is given",
    "whether the transcript holds the Done-Y",
    "the row's record"
  ],
  "hasDefinedTerm": [
    {
      "@type": "DefinedTerm",
      "termCode": "preview",
      "name": "preview",
      "dyad:when": "the trace is run at done-ready, without --out",
      "dyad:then": "the window runs from the first anchored prompt to the transcript's last record; nothing is written"
    },
    {
      "@type": "DefinedTerm",
      "termCode": "done",
      "name": "through the Done",
      "dyad:when": "the Done-Y has been received and the trace is written with --out --said-file <the Done words>, or the record already holds the Done; with neither, --out refuses and writes nothing",
      "dyad:then": "the window runs through the Done-Y the words anchor, read as a Done entry dated UTC today; the merges and the closing commit are the clerical tail, outside it; a stored trace is never a preview"
    },
    {
      "@type": "DefinedTerm",
      "termCode": "last-event",
      "name": "last d-work event",
      "dyad:when": "the record holds a Done the transcript does not",
      "dyad:then": "the window runs to the last d-work event, said under Limits"
    }
  ],
  "dyad:judgedBy": {
    "dyad:kind": "mechanical",
    "dyad:implementation": "scripts/trace.py"
  },
  "isPartOf": "urn:dyad:craft:dyad-operator",
  "dyad:home": "scripts/trace.py",
  "dyad:owner": "Rule-3",
  "dyad:alsoIn": [
    "playbooks/dwork-trace.md"
  ]
}
