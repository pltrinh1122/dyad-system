      "dyad:then": "the merge is asked as its own counter-prompt"
    },
    {
      "@type": "DefinedTerm",
      "termCode": "with-done",
      "name": "with-done",
      "dyad:when": "merge-disposition is with-done",
      "dyad:then": "the Done-Y of the completion counter-prompt that names the PR ratifies it"
    }
  ],
