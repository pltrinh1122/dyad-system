{
  "@context": [
    "https://schema.org",
    {
      "dyad": "urn:dyad:term:"
    }
  ],
  "@id": "urn:dyad:dmc:dyad-operator/attendance-mode",
  "@type": [
    "DefinedTermSet",
    "dyad:DecisionCriterion"
  ],
  "identifier": "attendance-mode",
  "name": "Attendance mode",
  "description": "The mode attendance reads over the live units (seats before #553).",
  "dyad:decides": "Which units of the live board does the operator pair with?",
  "dyad:inputs": [
    "the live units",
    "each unit's kind"
  ],
  "hasDefinedTerm": [
    {
      "@type": "DefinedTerm",
      "termCode": "all",
      "name": "every unit dyad",
      "dyad:when": "every live unit is paired",
      "dyad:then": "the mode is every unit dyad"
    },
    {
      "@type": "DefinedTerm",
      "termCode": "leader",
      "name": "only the home",
      "dyad:when": "only the home is a dyad unit",
      "dyad:then": "the mode is only the home"
    },
    {
      "@type": "DefinedTerm",
      "termCode": "some",
      "name": "some",
      "dyad:when": "some live units beside the home are paired",
      "dyad:then": "the mode is some"
    }
  ],
  "dyad:default": "only the home, with no live unit",
  "dyad:judgedBy": {
    "dyad:kind": "mechanical",
    "dyad:implementation": "guards/agent/sessions.py"
  },
  "isPartOf": "urn:dyad:craft:dyad-operator",
  "dyad:home": "rules/RULE-16-concurrent-sessions.md",
  "dyad:owner": "Rule-16"
}
