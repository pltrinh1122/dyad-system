    {
      "@type": "DefinedTerm",
      "termCode": "prompt",
      "name": "prompt",
      "dyad:when": "an Operator prompt: a birth into open, or backlog to open",
      "dyad:then": "a prompt entry of the provenance record"
    },
    {
      "@type": "DefinedTerm",
      "termCode": "disposition",
      "name": "disposition",
      "dyad:when": "an Operator answer to a counter-prompt",
      "dyad:then": "a disposed entry and the matching disposition entry of the record"
    },
    {
      "@type": "DefinedTerm",
      "termCode": "clerical",
      "name": "clerical",
      "dyad:when": "an Agent act a disposition already covers: re-planning when main moved, blocked to open",
      "dyad:then": "no entry of its own"
    }
