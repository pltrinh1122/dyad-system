{
  "@context": [
    "https://schema.org",
    {
      "dyad": "urn:dyad:term:"
    }
  ],
  "@id": "urn:dyad:dmc:dyad-operator/sweep-findings",
  "@type": [
    "DefinedTermSet",
    "dyad:DecisionCriterion"
  ],
  "identifier": "sweep-findings",
  "name": "Sweep findings over time",
  "description": "How long a landing, a board entry or a code push may wait before the home's read (dyad board resume) shows it as a stall finding.",
  "dyad:decides": "Has a recorded done answer, a board entry or a code push to main waited long enough to be a stall finding in the home's read?",
  "dyad:inputs": [
    "each operative Y done and whether its named heads are on main",
    "each board entry's since",
    "code pushes to main and their corroboration runs",
    "the preferences sweep-landing-hours, sweep-board-stale-days and sweep-ci-hours",
    "the full sweep's and the automaton's runs on main, and who pushed each ledger or events commit (#619)"
  ],
  "hasDefinedTerm": [
    {
      "@type": "DefinedTerm",
      "termCode": "landing",
      "name": "Y dones whose heads never landed",
      "dyad:when": "a Y done's named heads are not on main after sweep-landing-hours",
      "dyad:then": "a finding, told once to the home"
    },
    {
      "@type": "DefinedTerm",
      "termCode": "board",
      "name": "stale board entries",
      "dyad:when": "a board entry's since is older than sweep-board-stale-days",
      "dyad:then": "a finding, told once to the home"
    },
    {
      "@type": "DefinedTerm",
      "termCode": "ci",
      "name": "code pushes to main with no completed corroboration",
      "dyad:when": "a code push to main within the last sweep-ci-hours has no completed corroboration",
      "dyad:then": "a finding, told once to the home"
    },
    {
      "@type": "DefinedTerm",
      "termCode": "undelivered",
      "name": "sweeps not delivered",
      "dyad:when": "the newest code push to main within sweep-ci-hours has no d-work sweep run at it or after, or the newest ledger-only or events-only push not made by the jobs' own identity has no d-work automaton run at it or after; a run queued, in progress or completed with a result counts, a cancelled or skipped one does not",
      "dyad:then": "one finding per kind in the home's read: `finding: delivery: no full sweep …` or `finding: delivery: no stores sweep …`"
    }
  ],
  "dyad:tunables": [
    {
      "dyad:preference": "sweep-landing-hours",
      "dyad:defaultValue": "24",
      "dyad:allowed": "a positive integer (hours)",
      "dyad:readBy": "scripts/automaton.py"
    },
    {
      "dyad:preference": "sweep-board-stale-days",
      "dyad:defaultValue": "3",
      "dyad:allowed": "a positive integer (days)",
      "dyad:readBy": "scripts/automaton.py"
    },
    {
      "dyad:preference": "sweep-ci-hours",
      "dyad:defaultValue": "24",
      "dyad:allowed": "a positive integer (hours)",
      "dyad:readBy": "scripts/automaton.py"
    }
  ],
  "dyad:judgedBy": {
    "dyad:kind": "mechanical",
    "dyad:implementation": "scripts/automaton.py"
  },
  "isPartOf": "urn:dyad:craft:dyad-operator",
  "dyad:home": "scripts/automaton.py",
  "dyad:owner": "Rule-14"
}
