{
  "@context": [
    "https://schema.org",
    {
      "dyad": "urn:dyad:term:"
    }
  ],
  "@id": "urn:dyad:dmc:dyad-operator/disposition-budget",
  "@type": [
    "DefinedTermSet",
    "dyad:DecisionCriterion"
  ],
  "identifier": "disposition-budget",
  "name": "Disposition budget",
  "description": "Reads a d-work's disposition count against the budget its plan declared.",
  "dyad:decides": "How does a d-work's count of Operator dispositions read against its plan's disposition budget?",
  "dyad:inputs": [
    "the plan file's disposition budget line",
    "the row's disposed column"
  ],
  "hasDefinedTerm": [
    {
      "@type": "DefinedTerm",
      "termCode": "designed",
      "name": "exactly two",
      "dyad:when": "the plan declares two (one plan-Y, one Done-Y) and the row holds two",
      "dyad:then": "nothing to state beyond the pair"
    },
    {
      "@type": "DefinedTerm",
      "termCode": "larger",
      "name": "larger than two",
      "dyad:when": "the plan declares more than two for a destructive host action, a release or a blocking question",
      "dyad:then": "not a fault: the Operator reads the cost before authorizing the shape"
    },
    {
      "@type": "DefinedTerm",
      "termCode": "overrun",
      "name": "overrun",
      "dyad:when": "the row's count exceeds the declared budget, as an amend does",
      "dyad:then": "the completion evidence says by how much and why; the next revision's budget line declares it"
    }
  ],
  "dyad:judgedBy": {
    "dyad:kind": "inference",
    "dyad:implementation": null
  },
  "isPartOf": "urn:dyad:craft:dyad-operator",
  "dyad:home": "playbooks/disposition-digest.md",
  "dyad:owner": "Rule-3"
}
