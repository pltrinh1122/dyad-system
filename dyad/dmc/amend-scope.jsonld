    {
      "@type": "DefinedTerm",
      "termCode": "same",
      "name": "same proposal revised",
      "dyad:when": "the text asks for that same proposal revised",
      "dyad:then": "no second row; the plan file is revised in place, the refused revision kept"
    },
    {
      "@type": "DefinedTerm",
      "termCode": "else",
      "name": "something else",
      "dyad:when": "the text asks for something else",
      "dyad:then": "a prompt like any other; opens its own d-work"
    }
