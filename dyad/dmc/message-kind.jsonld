{
  "@context": [
    "https://schema.org",
    {
      "dyad": "urn:dyad:term:"
    }
  ],
  "@id": "urn:dyad:dmc:dyad-operator/message-kind",
  "@type": [
    "DefinedTermSet",
    "dyad:DecisionCriterion"
  ],
  "identifier": "message-kind",
  "name": "Message kind",
  "description": "Classifies an incoming message by what it opens.",
  "dyad:decides": "What does this message open?",
  "dyad:inputs": [
    "the sender (Operator or another agent)",
    "whether it answers a counter-prompt",
    "whether it carries text"
  ],
  "hasDefinedTerm": [
    {
      "@type": "DefinedTerm",
      "termCode": "prompt",
      "name": "prompt",
      "dyad:when": "an Operator prompt, or text accompanying a disposal",
      "dyad:then": "opens a d-work; an open d-work is suspended and d-works stack"
    },
    {
      "@type": "DefinedTerm",
      "termCode": "bare",
      "name": "bare",
      "dyad:when": "a bare Y or N to a counter-prompt",
      "dyad:then": "not a prompt; opens nothing"
    },
    {
      "@type": "DefinedTerm",
      "termCode": "accretion",
      "name": "accretion",
      "dyad:when": "the Agent opens a row while executing another, inside the stated mandate scope",
      "dyad:then": "a row born open under the plan-Y; nothing is suspended"
    },
    {
      "@type": "DefinedTerm",
      "termCode": "intake",
      "name": "intake",
      "dyad:when": "a message from another agent",
      "dyad:then": "opens no d-work; surfaced to the Operator as a candidate row"
    }
  ],
  "dyad:judgedBy": {
    "dyad:kind": "inference",
    "dyad:implementation": null
  },
  "isPartOf": "urn:dyad:craft:dyad-operator",
  "dyad:home": "rules/RULE-3-d-work.md",
  "dyad:owner": "Rule-3"
}
