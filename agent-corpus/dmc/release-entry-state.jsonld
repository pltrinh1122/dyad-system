{
  "@context": [
    "https://schema.org",
    {
      "dyad": "urn:dyad:term:"
    }
  ],
  "@id": "urn:dyad:dmc:instance/release-entry-state",
  "@type": [
    "DefinedTermSet",
    "dyad:DecisionCriterion"
  ],
  "identifier": "release-entry-state",
  "name": "Release entry state",
  "description": "The state of one recorded release entry against origin's tags and the hosting's Releases.",
  "dyad:decides": "Has this recorded `Y release <tag> at <sha>` entry been published as recorded?",
  "dyad:inputs": [
    "every `Y release <tag> at <sha>` entry in agent-corpus/d-work/rows/ (an entry without `at <sha>` predates #461 and is not read)",
    "the tag on origin, its peeled commit for an annotated tag",
    "the hosting's Release for the tag",
    "the released workflow's runs on the entry's commit"
  ],
  "hasDefinedTerm": [
    {
      "@type": "DefinedTerm",
      "termCode": "pass",
      "name": "Pass",
      "dyad:when": "the tag exists on origin, peels to the cut sha, and its Release exists",
      "dyad:then": "nothing to report"
    },
    {
      "@type": "DefinedTerm",
      "termCode": "pending",
      "name": "pending",
      "dyad:when": "no tag yet and the released workflow has not run on the entry's commit",
      "dyad:then": "the normal state between the entry landing and the run; wait"
    },
    {
      "@type": "DefinedTerm",
      "termCode": "failed-run",
      "name": "failed run",
      "dyad:when": "no tag yet although the released workflow has run on the entry's commit",
      "dyad:then": "read the run's log and report it to the distribute seat; a retry is the operator's destructive act"
    },
    {
      "@type": "DefinedTerm",
      "termCode": "no-tag",
      "name": "no tag",
      "dyad:when": "no tag on origin (health's reading, which does not tell pending from failed)",
      "dyad:then": "health prints `no tag: <tag>` and exits 1"
    },
    {
      "@type": "DefinedTerm",
      "termCode": "not-at-cut",
      "name": "tag not at cut",
      "dyad:when": "the tag exists but does not peel to the recorded cut sha",
      "dyad:then": "health prints `tag not at cut: <tag> (<sha>)` and exits 1; a tag never moves, so the operator decides"
    },
    {
      "@type": "DefinedTerm",
      "termCode": "no-release",
      "name": "no Release",
      "dyad:when": "the tag exists but the hosting has no Release for it",
      "dyad:then": "health prints `no Release: <tag>` and exits 1"
    }
  ],
  "dyad:precedence": "per entry: not-at-cut, no-release and no-tag are health's lines; pending and failed-run split no-tag by whether the workflow has run",
  "dyad:default": "zero entries in the #461 form: pass, nothing to reconcile",
  "dyad:judgedBy": {
    "dyad:kind": "mechanical",
    "dyad:implementation": null
  },
  "isPartOf": "urn:dyad:instance",
  "dyad:home": "workstation-corpus/runbooks/released.md",
  "dyad:alsoIn": [
    "dyad/scripts/release.py"
  ],
  "dyad:owner": "sysadmin:server-instances"
}
