  "identifier": "failure-modes-1010",
  "name": "Incident failure modes (full derivation)",
  "description": "The observed failure mode each incident row was assigned in the full derivation, reconciled from two independent views and extended by its deltas.",
  "dyad:decides": "By which mechanism did this incident happen?",
  "dyad:inputs": [
    "the incident row's cause and what cells",
    "the two independent derivations",
    "the one-sentence test: one change that stops every row of the mode at one moment"
  ],
  "hasDefinedTerm": [
